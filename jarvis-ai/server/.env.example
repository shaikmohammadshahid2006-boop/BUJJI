# ============================================================
# JARVIS AI Server - Environment Variables
# ============================================================

# Supabase Configuration
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase JWT Secret (found in Project Settings -> API -> JWT Settings)
# Used to verify Bearer tokens sent from the frontend
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Google Gemini AI API Key (kept strictly on the backend!)
GEMINI_API_KEY=AQ.your_gemini_api_key_here

# Allowed CORS Origins (comma-separated)
# In production on Render, set this to your Vercel deployment URL
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Server Port (Render sets this dynamically via PORT env variable)
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production
